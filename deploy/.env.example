# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Root domain of the test server (placeholder). DNS: A records for DOMAIN and *.DOMAIN → server IP.
DOMAIN=drivebook-test.example.com

# Dealer subdomains that get HTTPS certificates (comma-separated). The seed creates the "demo" dealer.
# Add a host here (and restart caddy) for every dealer you create in the backoffice.
DEALER_HOSTS=demo.drivebook-test.example.com

# E-mail for Let's Encrypt expiry notices (optional).
ACME_EMAIL=

# Strong random values:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
AUTH_SECRET=change-me-at-least-32-characters-long

# Backoffice superadmin created on first start (gets a set-password link, see README).
SEED_SUPERADMIN_EMAIL=you@example.com

# Password for https://DOMAIN/_dev/inbox (fake SMS codes and e-mails).
# Generate the hash:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ characters.
INBOX_USER=drivebook
INBOX_PASSWORD_HASH='$2a$14$replace-with-generated-hash'

# Demo mode: fake SMS / e-mail shown in the inbox. For real messages set NOTIFY_FAKE=0 and fill in the keys.
NOTIFY_FAKE=1
DEV_INBOX_ENABLED=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DriveBook

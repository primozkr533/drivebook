# Optional overrides for `docker compose up`. Every value below is already the
# committed default, so copying this to .env is not required. Never commit .env.

# Host port for Postgres (Vitest on the host connects here).
DB_PORT=5432
# Postgres connection string; inside compose the host is `db`, from the host use localhost.
DATABASE_URL=postgres://drivebook:drivebook@db:5432/drivebook
# Postgres connection string for Vitest (drivebook_test); must differ from DATABASE_URL.
TEST_DATABASE_URL=postgres://drivebook:drivebook@localhost:5432/drivebook_test
# Runtime environment: development | test | production.
APP_ENV=development
# Root domain for dealer subdomains and the app./admin. surfaces.
BASE_DOMAIN=drivebook.localhost
# Apply pending database migrations when the server starts.
RUN_MIGRATIONS_ON_START=true
# Run the idempotent seed (default plan, superadmin, demo dealer) when the server starts.
SEED_ON_START=true
# Email of the superadmin account created by the seed.
SEED_SUPERADMIN_EMAIL=admin@drivebook.localhost
# Secret (at least 32 chars) that encrypts TOTP secrets at rest and signs the TOTP pending token; required in production.
AUTH_SECRET=drivebook-dev-auth-secret-not-for-production
# Set to 1 to enable the gate-only test login route; off by default.
FARM_TEST_AUTH=
# Set to 1 to serve the dev inbox in production; outside production it is always on.
DEV_INBOX_ENABLED=
# Set to 1 to always use the fake SMS/email adapters, even when provider keys are present.
NOTIFY_FAKE=
# Set to 1 to let a production server/worker start with the fake SMS/email adapters (staging only); off by default.
ALLOW_FAKE_PROVIDERS=
# Scheme for absolute links in emails: https (default) or http (dev).
PUBLIC_URL_SCHEME=http
# Optional port appended to absolute links in emails (dev: 3000; empty in production).
PUBLIC_URL_PORT=3000
# Directory for uploaded files (dealer logos); compose mounts the `storage` volume at /data/storage. Default outside compose: ./data/storage.
STORAGE_DIR=/data/storage

# Twilio account SID for SMS; when the Twilio keys are empty the app uses a console/mock SMS provider.
TWILIO_ACCOUNT_SID=
# Twilio auth token; when empty the app uses a console/mock SMS provider.
TWILIO_AUTH_TOKEN=
# Twilio sender phone number (E.164); when empty the app uses a console/mock SMS provider.
TWILIO_FROM_NUMBER=

# Brevo API key for transactional email; when empty the app uses a console/mock email provider.
BREVO_API_KEY=
# Brevo verified sender address; when empty the app uses a console/mock email provider.
BREVO_SENDER_EMAIL=
# Display name on outgoing email (used once Brevo keys are set; otherwise the console/mock email provider).
BREVO_SENDER_NAME=DriveBook

# Cloudflare API token for dealer custom domains; when empty the app uses a console/mock DNS provider.
CLOUDFLARE_API_TOKEN=
# Cloudflare zone ID; when empty the app uses a console/mock DNS provider.
CLOUDFLARE_ZONE_ID=

# --- Production stack only (docker-compose.prod.yml, Caddy, backup); not read by the app. ---
# Contact e-mail for Let's Encrypt certificates.
ACME_EMAIL=
# Cloudflare token with Zone:DNS:Edit on the drivebook.si zone for Caddy's DNS-01 wildcard cert; separate from CLOUDFLARE_API_TOKEN (least privilege).
CLOUDFLARE_DNS_API_TOKEN=
# Production Postgres container user; DATABASE_URL must use the same value.
POSTGRES_USER=
# Production Postgres container password; DATABASE_URL must use the same value.
POSTGRES_PASSWORD=
# Production Postgres container database name; DATABASE_URL must use the same value.
POSTGRES_DB=
# Days of nightly backups to keep.
BACKUP_RETENTION_DAYS=14
